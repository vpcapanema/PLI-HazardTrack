"""Extrai imagens das figuras 3.3.3-3, 5, 7, 9 (RAGEO por regiao)
e 3.3.3-13, 15, 17, 19 (RAHID por regiao) do PRODUTO 7.
"""
import sys
from pathlib import Path
import fitz

sys.stdout.reconfigure(encoding="utf-8")

PDF = Path("data/PDFs_sistema_monitoramento__IPA-DER") / \
      "4 PRODUTO 7 Plano de Contingência.pdf"
OUT = Path("ferramentas/extracao-ra/_imgs")
OUT.mkdir(parents=True, exist_ok=True)

# Mapeamento pagina-1-indexed -> (tipo, regiao, fig_id)
FIGS = {
    50: ("rageo", 0, "3.3.3-1"),   # geral - toda area de estudo
    52: ("rageo", 1, "3.3.3-3"),
    54: ("rageo", 2, "3.3.3-5"),
    56: ("rageo", 3, "3.3.3-7"),
    58: ("rageo", 4, "3.3.3-9"),
    61: ("rahid", 0, "3.3.3-11"),  # geral - toda area de estudo
    63: ("rahid", 1, "3.3.3-13"),
    65: ("rahid", 2, "3.3.3-15"),
    67: ("rahid", 3, "3.3.3-17"),
    69: ("rahid", 4, "3.3.3-19"),
}

doc = fitz.open(PDF)
for page1, (tipo, rid, fig_id) in FIGS.items():
    page = doc[page1 - 1]
    imgs = page.get_images(full=True)
    if not imgs:
        print(f"P{page1} sem imagens")
        continue
    # pega a maior imagem embutida (o mapa)
    sizes = []
    for img in imgs:
        xref = img[0]
        try:
            pix = fitz.Pixmap(doc, xref)
            sizes.append((pix.width * pix.height, xref, pix.width, pix.height))
            pix = None
        except Exception:
            continue
    sizes.sort(reverse=True)
    _, xref, w, h = sizes[0]
    pix = fitz.Pixmap(doc, xref)
    if pix.alpha:
        pix = fitz.Pixmap(fitz.csRGB, pix)
    fname = f"{tipo}_r{rid}_p{page1}_{fig_id.replace('.', '_')}.png"
    pix.save(OUT / fname)
    print(f"P{page1} -> {fname}  ({w}x{h})")
    pix = None
print(f"\nExtraido para: {OUT}")
