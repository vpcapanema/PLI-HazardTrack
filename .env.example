# ============================================================================
# PLI-HazardTrack - exemplo de variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione um .env real (ja esta no .gitignore).
# ============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=5050

# --- Operacao do scheduler --------------------------------------------------
SAMAEG_WORKERS=12
SAMAEG_DEGRADED_24H=6
SAMAEG_FORCE_MOCK=0
SAMAEG_USE_MANUAL_RA=0

# --- Chuva: ancora de pluviometros SIBH ------------------------------------
SAMAEG_GAUGE_CORRECTION=1
SAMAEG_GAUGE_RADIUS_KM=30
SAMAEG_GAUGE_MAX_WEIGHT=0.85
# Guarda contra falso positivo: exige 3 estacoes com >=18 h de cobertura,
# ao menos uma a <=15 km e 80% delas secas antes de substituir um acumulado
# MERGE extremo (>=50 mm/24 h) pelo IDW observado em solo.
SAMAEG_GAUGE_DRY_GUARD=1
SAMAEG_GAUGE_DRY_MIN_STATIONS=3
SAMAEG_GAUGE_DRY_MAX_NEAREST_KM=15
SAMAEG_GAUGE_DRY_MAX_MM=2
SAMAEG_GAUGE_DRY_MIN_SAT_MM=50
SAMAEG_GAUGE_DRY_MIN_FRACTION=0.8
SAMAEG_GAUGE_DRY_MIN_COVERAGE_H=18

# --- Chuva: pluviometros SIBH como fonte primaria --------------------------
# UAs com estacoes a <=15 km usam a serie horaria medida em solo (latencia
# de minutos); exige a ultima hora e 90% das horas de 24 h/96 h cobertas.
# As demais UAs seguem com MERGE/INPE.
SAMAEG_GAUGE_PRIMARY=1
SAMAEG_GAUGE_PRIMARY_RADIUS_KM=15
SAMAEG_GAUGE_PRIMARY_MIN_COVERAGE=0.9
# Descarta estacao seca em 24 h (<=0.5 mm) quando >=3 vizinhas a <=10 km
# tem mediana >=5 mm (pluviometro travado em zero).
SAMAEG_GAUGE_PRIMARY_SUSPECT_FILTER=1
SAMAEG_GAUGE_PRIMARY_SUSPECT_KM=10
SAMAEG_GAUGE_PRIMARY_SUSPECT_DRY_MM=0.5
SAMAEG_GAUGE_PRIMARY_SUSPECT_WET_MM=5
SAMAEG_GAUGE_PRIMARY_SUSPECT_MIN_NEIGHBORS=3

# --- Area /admin: autenticacao SIGMA-PLI (recomendado) ----------------------
# API HTTP oficial do SIGMA. Tem prioridade sobre PostgreSQL e habilita links
# de recuperacao de senha/criacao de conta no card de login.
SIGMA_API_BASE_URL=http://56.125.163.194

# Fallback PostgreSQL somente leitura contra o banco do SIGMA-PLI.
SIGMA_POSTGRES_HOST=sigma_pli_db
SIGMA_POSTGRES_PORT=5432
SIGMA_POSTGRES_DATABASE=sigma_pli_qr53
SIGMA_POSTGRES_USER=sigma_user
SIGMA_POSTGRES_PASSWORD=
SIGMA_POSTGRES_SSLMODE=disable

# Fallback local (somente dev, sem banco SIGMA):
# ADMIN_USER=admin
# ADMIN_PASS=troque-esta-senha

# Chave para assinar cookies da sessao /admin.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=

# --- API publica (/api/public/*) --------------------------------------------
# Quando definida, integradores externos devem enviar X-API-Key ou
# Authorization: Bearer <chave>. Sem valor = feed aberto (dev/local).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_API_KEY=

# --- Cameras DER-SP (proxy mapa) --------------------------------------------
DER_CAMERAS_URL=http://200.144.30.103:8084
DER_CAMERAS_CACHE_TTL=300

# --- VM AWS: certificado TLS (Let's Encrypt via sync-vm) --------------------
# CERTBOT_EMAIL=seu-email@exemplo.com

# --- Controles runtime (/admin → Controles de alerta) -----------------------
# PLI_RUNTIME_DIR=/app/data/_runtime
# QUEIMADAS_AUTO=1
# QUEIMADAS_POLL_MIN=30
