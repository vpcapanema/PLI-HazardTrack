# PLI-HazardTrack — HTTP only (bootstrap ACME / sem certificado ainda)
# Hostname: pli-hazardtrack.56-125-163-194.sslip.io

server {
    listen 80;
    listen [::]:80;

    server_name pli-hazardtrack.56-125-163-194.sslip.io;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    include /etc/nginx/snippets/pli-hazardtrack-locations.conf;
}
