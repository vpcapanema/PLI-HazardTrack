"""Diagnostico: compara coluna RAGEO calibrada com a Figura 3.3.3-X
de cada regiao + analise por escala (25K/10K/1K)."""
import sys
from pathlib import Path

import matplotlib.pyplot as plt
import geopandas as gpd
import numpy as np
from PIL import Image

sys.stdout.reconfigure(encoding="utf-8")

GPKG = "data/pli-hazardtrack.gpkg"
IMG_DIR = Path("ferramentas/extracao-ra/_imgs_hires")
OUT = Path("ferramentas/extracao-ra/_diag_rageo_por_regiao.png")

COR = {0: "#7F7F7F", 1: "#7FFF00", 2: "#FFFF00",
       3: "#FF8000", 4: "#FF0000"}
FIGS = {1: "rageo_r1_p52_3_3_3-3.png",
        2: "rageo_r2_p54_3_3_3-5.png",
        3: "rageo_r3_p56_3_3_3-7.png",
        4: "rageo_r4_p58_3_3_3-9.png"}

uas = gpd.read_file(GPKG, layer="uas_area_estudo")
regs = gpd.read_file(GPKG, layer="regioes_estudo")

print("Resumo por (Regiao, Escala, Classe):")
print(uas.groupby(["regiao_id", "escala", "RAGEO"]).size()
      .unstack(fill_value=0).to_string())

fig, axes = plt.subplots(4, 3, figsize=(24, 28), dpi=100)
for i, rid in enumerate([1, 2, 3, 4]):
    ax = axes[i, 0]
    ax.imshow(Image.open(IMG_DIR / FIGS[rid]))
    ax.set_title(f"R{rid} - PDF (Figura 3.3.3-{2*i+3})", fontsize=12)
    ax.axis("off")

    sub_r = uas[uas["regiao_id"] == rid]

    # Coluna 2: TODAS as UAs da regiao (juntas)
    ax = axes[i, 1]
    regs[regs["regiao_id"] == rid].boundary.plot(
        ax=ax, color="magenta", linewidth=1.0)
    for k, cor in COR.items():
        sk = sub_r[sub_r["RAGEO"] == k]
        if len(sk):
            sk.plot(ax=ax, color=cor, linewidth=3,
                    label=f"RA{k}: {len(sk)} UAs")
    ax.legend(loc="best", fontsize=8)
    ax.set_title(f"R{rid} - UAs RAGEO calibrado (todas)", fontsize=12)
    ax.set_aspect("equal")
    ax.grid(alpha=0.3)

    # Coluna 3: separado por escala (mais transparente para 25K/10K)
    ax = axes[i, 2]
    regs[regs["regiao_id"] == rid].boundary.plot(
        ax=ax, color="magenta", linewidth=1.0)
    for esc, lw in [("25K", 6), ("10K", 3.5), ("1K", 1.5)]:
        sub_e = sub_r[sub_r["escala"] == esc]
        for k, cor in COR.items():
            sk = sub_e[sub_e["RAGEO"] == k]
            if len(sk):
                sk.plot(ax=ax, color=cor, linewidth=lw, alpha=0.7)
    ax.set_title(
        f"R{rid} - mesma camada empilhada por escala "
        f"(25K grosso > 10K medio > 1K fino)", fontsize=10)
    ax.set_aspect("equal")
    ax.grid(alpha=0.3)

plt.tight_layout()
OUT.parent.mkdir(parents=True, exist_ok=True)
plt.savefig(OUT, dpi=110, bbox_inches="tight")
print(f"\nPNG: {OUT}")
