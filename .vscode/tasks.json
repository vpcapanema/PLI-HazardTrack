{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy: atualizar VM agora",
      "type": "shell",
      "command": "${workspaceFolder}/sync-vm.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
