{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy: commit, push e VM",
      "type": "shell",
      "command": "${workspaceFolder}/deploy-vm.bat",
      "args": ["${input:deployCommitMessage}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "deployCommitMessage",
      "type": "promptString",
      "description": "Mensagem do commit (deploy para a VM)",
      "default": "deploy: atualiza producao"
    }
  ]
}
