# ============================================================================
# PLI-HazardTrack - exemplo de variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione um .env real (ja esta no .gitignore).
# ============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=5050

# --- Operacao do scheduler --------------------------------------------------
SAMAEG_WORKERS=12
SAMAEG_DEGRADED_24H=6
SAMAEG_FORCE_MOCK=0
SAMAEG_USE_MANUAL_RA=0

# --- Pagina /ops: autenticacao via SRA --------------------------------------
# Conexao SOMENTE LEITURA com o Postgres do SRA. O PLI-HazardTrack so
# faz SELECT na tabela users; a comparacao bcrypt acontece no proprio PLI.
# Use o mesmo usuario que o SRA ja usa - nao crie role nova no banco.
SRA_DB_HOST=sra-postgres
SRA_DB_PORT=5432
SRA_DB_NAME=sra
SRA_DB_USER=sra_user
SRA_DB_PASSWORD=

# URL para "Esqueci minha senha". Aponta para a tela de recuperacao do SRA.
# Em desenvolvimento local: /recuperar-senha
# Em producao: https://sra.exemplo.com/recuperar-senha
SRA_RESET_URL=/recuperar-senha

# Chave para assinar cookies da sessao /ops.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
OPS_SECRET=
