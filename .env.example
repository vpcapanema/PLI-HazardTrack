# ============================================================================
# PLI-HazardTrack - exemplo de variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione um .env real (ja esta no .gitignore).
# ============================================================================

# --- Servidor ---------------------------------------------------------------
# Porta local em desenvolvimento (Render injeta PORT em prod)
PORT=5050

# --- Operacao do scheduler --------------------------------------------------
# Workers paralelos para baixar GRIBs do INPE.
# Render free (0.5 CPU / 512MB): 4 e seguro. Local: 8 funciona bem.
SAMAEG_WORKERS=4

# Em quantas horas faltando dentro de 24h o sistema marca "degradado"
SAMAEG_DEGRADED_24H=6

# Modo de desenvolvimento: chuva sintetica reproduzivel.
# NAO USAR EM PRODUCAO.
SAMAEG_FORCE_MOCK=0

# Modo legado de RA: usa os valores RA hard-coded em vez de neutralizar para 1.
SAMAEG_USE_MANUAL_RA=0

# Pula o bootstrap (scheduler + primeiro update) - util em testes.
# SAMAEG_DISABLE_BOOTSTRAP=1

# --- Pagina de Operacoes (/ops) --------------------------------------------
# Usuario e senha para acessar /ops/status. Sem OPS_PASS, o /ops fica bloqueado.
OPS_USER=admin
OPS_PASS=trocar-em-producao
# Alternativa mais segura: passar o hash SHA-256 da senha em vez de texto.
# Gere com: python -c "import hashlib; print(hashlib.sha256(b'sua-senha').hexdigest())"
# Se OPS_PASS_SHA256 estiver definida, ela tem precedencia sobre OPS_PASS.
# OPS_PASS_SHA256=

# Chave para assinar cookies da sessao /ops. Em producao deve ser longa e aleatoria.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
OPS_SECRET=

# Forca cookies seguros mesmo fora do Render (so use em ambientes 100% HTTPS)
# FORCE_HTTPS_COOKIES=1
