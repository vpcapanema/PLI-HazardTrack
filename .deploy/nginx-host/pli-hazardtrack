# PLI-HazardTrack — virtual host Nginx (HTTP redirect + HTTPS)
# Hostname: pli-hazardtrack.56-125-163-194.sslip.io

upstream pli_hazardtrack_app {
    server 127.0.0.1:5050;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;

    server_name pli-hazardtrack.56-125-163-194.sslip.io;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name pli-hazardtrack.56-125-163-194.sslip.io;

    ssl_certificate     /etc/letsencrypt/live/pli-hazardtrack.56-125-163-194.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pli-hazardtrack.56-125-163-194.sslip.io/privkey.pem;
    include /etc/nginx/snippets/pli-hazardtrack-ssl-params.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/pli-hazardtrack-locations.conf;
}
