# ============================================================================
# PLI-HazardTrack - exemplo de variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione um .env real (ja esta no .gitignore).
# ============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=5050

# --- Operacao do scheduler --------------------------------------------------
SAMAEG_WORKERS=12
SAMAEG_DEGRADED_24H=6
SAMAEG_FORCE_MOCK=0
SAMAEG_USE_MANUAL_RA=0

# --- Area /admin: autenticacao SIGMA-PLI (recomendado) ----------------------
# Na VM, o stack sobe pli-hazardtrack-db (container pli_hazzardtracker_db).
# Banco dedicado deste sistema: pli_hazzardtracker_db
SIGMA_POSTGRES_HOST=pli-hazardtrack-db
SIGMA_POSTGRES_PORT=5432
SIGMA_POSTGRES_DATABASE=pli_hazzardtracker_db
SIGMA_POSTGRES_USER=sigma_user
SIGMA_POSTGRES_PASSWORD=
SIGMA_POSTGRES_SSLMODE=disable

# Alternativa: API HTTP do SIGMA (tem prioridade se definida junto com Postgres)
# SIGMA_API_BASE_URL=http://56.125.163.194

# Fallback local (somente dev, sem banco SIGMA):
# ADMIN_USER=admin
# ADMIN_PASS=troque-esta-senha

# Chave para assinar cookies da sessao /admin.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=

# --- API publica (/api/public/*) --------------------------------------------
# Quando definida, integradores externos devem enviar X-API-Key ou
# Authorization: Bearer <chave>. Sem valor = feed aberto (dev/local).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_API_KEY=

# --- Cameras DER-SP (proxy mapa) --------------------------------------------
DER_CAMERAS_URL=http://200.144.30.103:8084
DER_CAMERAS_CACHE_TTL=300

# --- VM AWS: certificado TLS (Let's Encrypt via sync-vm) --------------------
# CERTBOT_EMAIL=seu-email@exemplo.com

# --- Controles runtime (/admin → Controles de alerta) -----------------------
# PLI_RUNTIME_DIR=/app/data/_runtime
# QUEIMADAS_AUTO=1
# QUEIMADAS_POLL_MIN=30
